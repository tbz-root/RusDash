{
	"geode": "5.10.1",
	"early-load": true,
	"gd": {
		"win": "2.2081",
		"android": "2.2081"
	},
	"id": "tabz.rusdash",
	"name": "\u200BRusDash",
	"version": "v1.0.5",
	"developers": ["Tabz", "CMDs"],
	"trailer": false,
	"description": "Geode modding GDPS project",
	"dependencies": {
		"geode.node-ids": ">=v1.23.3",
		"dasshu.badgified": ">=1.0.3",
		"bitz.customprofiles": ">=1.1.5",
		"alk.ime-input": ">=1.0.4"
	},
	"incompatibilities": {
		"alphalaneous.tinker": {
			"breaking": true,
			"version": "*"
		},
		"techstudent10.settings_plus": {
			"breaking": false,
			"version": "*"
		}
	},
	"settings": {
		"enable-mirror": {
			"name": "Built-in VPN",
			"description": "When enabled, all requests is proxing by rustps.online, when disabled, they will be proxied by www.rustps.online!",
			"type": "bool",
			"default": false
		}
	},
	"resources": {
		"spritesheets": {
			"RD_modSheet01": [
				"resources/*.png"
			],
			"RD_iconsSheet01": [
				"resources/icons/*.png"
			],
			"RD_backport2209Sheet": [
				"resources/2209/*.png"
			],
			"RD_profileSheet01": [
				"resources/profile/*.png"
			],
			"RD_commentSheet01": [
				"resources/comments/*.png"
			]
		},
		"sprites": [
			"resources/sprites/*.png",
			"resources/sprites/2209/*.png"
		],
		"files": [
			"resources/docs/script-trigger.md",
			"resources/levels.txt",
			"resources/badges/*.png"
		]
	},
	"api": {
		"include": [
			"resources/tabz.rusdash/levels/*.txt",
			"resources/tabz.rusdash/resources/*.png",
			"resources/tabz.rusdash/resources/*.plist",
			"resources/tabz.rusdash/resources/*.fnt",
			"include/*.hpp"
		]
	},
	"tags": [
		"offline",
		"online",
		"gameplay",
		"utility"
	],
	"links": {
		"homepage": "https://www.rustps.online",
		"community": "https://t.me/RusDash",
		"source": "https://github.com/tbz-root/RusDash"
	},
	"issues": {
		"info": "Have Problems With Mod or Found Bugs?",
		"url": "https://github.com/tbz-root/RusDash/issues"
	}
}