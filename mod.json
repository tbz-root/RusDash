{
    "geode": "5.10.1",
    "early-load": true,
    "gd": {
        "win": "2.2081",
        "android": "2.2081"
    },
    "id": "tabz.rusdash",
    "name": "RusDash",
    "version": "v1.0.3",
    "developers": ["Tabz", "CMDs"],
    "description": "All In One GDPS Mod",
    "dependencies": {
        "geode.node-ids": ">=v1.23.3",
        "dasshu.badgified": ">=1.0.3",
        "bitz.customprofiles": ">=1.1.5",
        "alk.ime-input": ">=1.0.4",
        "roadhogstudios.game-objects-factory": ">=1.9.0"
    },
    "incompatibilities": {
        "alphalaneous.tinker": {
            "breaking": true,
            "version": "*"
        },
        "techstudent10.settings_plus": {
            "breaking": false,
            "version": "*"
        },
        "alphalaneous.settings_everywhere": {
            "breaking": false,
            "version": "*"
        }
    },
    "settings": {
        "use-mirror": {
            "name": "Mirror Mode",
            "description": "Use www.rustps.online as the primary server.",
            "type": "bool",
            "default": false
        },
        "profile-theme": {
            "name": "Profile Theme",
            "description": "Choose appearance of your profile main card.",
            "type": "string",
            "default": "default"
        }
    },
    "resources": {
        "spritesheets": {
            "RD_modSheet01": [
                "resources/*.png"
            ],
            "RD_profileSheet01": [
                "resources/profile/*.png"
            ]
        },
        "sprites": [
            "resources/sprites/*.png"
        ],
        "files": [
            "resources/levels.txt",
            "resources/badges/*.png"
        ]
    },
	"api": {
		"include": [
			"resources/tabz.rusdash/levels/*.txt",
            "resources/tabz.rusdash/resources/*.png",
            "resources/tabz.rusdash/resources/*.plist",
            "resources/tabz.rusdash/resources/*.fnt"
		]
	},
    "tags": ["offline", "online", "gameplay", "utility"],
    "links": {
        "homepage": "https://rustps.online",
        "community": "https://t.me/RusDash",
        "source": "https://github.com/tbz-root/RusDash"
    },
    "issues": {
        "info": "Have Problems With Mod or Found Bugs?",
        "url": "https://github.com/tbz-root/RusDash/issues"
    }
}
