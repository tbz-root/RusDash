{
    "geode": "5.9.0",
    "early-load": true,
    "gd": {
        "win": "2.2081",
        "android": "2.2081",
        "mac": "2.2081",
        "ios": "2.2081"
    },
    "id": "tabz.rusdash",
    "name": "RusDash",
    "version": "v1.0.1",
    "developer": "Tabz & CMDs",
    "description": "All In One GDPS Mod",
    "dependencies": {
        "geode.node-ids": ">=v1.23.3",
        "dasshu.badgified": ">=1.0.0",
        "bitz.customprofiles": ">=1.0.0"
    },
    "settings": {
        "use-mirror": {
            "name": "Mirror Mode",
            "description": "Use www.rustps.online as the primary server.",
            "type": "bool",
            "default": false
        },
        "profile-theme": {
            "name": "Profile Theme",
            "description": "Choose appearance of your profile main card.",
            "type": "string",
            "default": "default"
        }
    },
    "resources": {
        "spritesheets": {
            "RD_modSheet01": [
                "resources/*.png"
            ],
            "RD_profileSheet01": [
                "resources/profile/*.png"
            ]
        },
        "files": [
            "resources/levels.txt",
            "resources/badges/*.png"
        ]
    },
	"api": {
		"include": [
			"resources/tabz.rusdash/levels/*.txt"
		]
	},
    "tags": ["offline", "online", "gameplay", "utility"],
    "links": {
        "homepage": "https://rustps.online",
        "community": "https://t.me/RusDash",
        "source": "https://github.com/tbz-root/RusDash"
    },
    "issues": {
        "info": "Have Problems With Mod Or Found Bugs?",
        "url": "https://github.com/tbz-root/RusDash/issues"
    }
}