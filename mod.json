{
	"geode": "6.0.0-alpha.1",
	"early-load": true,
	"gd": {
		"win": "2.2091",
		"android": "2.2091"
	},
	"id": "tabz.rusdash",
	"name": "\u200BRusDash",
	"version": "v1.1.1",
	"developers": ["Tabz", "CMDs"],
	"trailer": false,
	"description": "Geode modding GDPS project",
	"dependencies": {
		"geode.node-ids": ">=v1.23.3"
	},
	"incompatibilities": {
		"km7dev.gdps-swticher": {
			"breaking": true,
			"version": "*"
		}
	},
	"settings": {
		"enable-mirror": {
			"name": "Built-in VPN",
			"description": "When enabled, all requests is proxing by rustps.online, when disabled, they will be proxied by www.rustps.online!",
			"type": "bool",
			"default": false
		},
		"language": {
			"name": "Language",
			"description": "Russian yayyy",
			"type":"string",
			"one-of": ["English", "Русский"],
			"default": "Русский"
		},
		"restartbuttons": {
			"name": "Restart Buttons",
			"type": "title"
		},
		"restart-keybind": {
			"name": "Restart Keybind",
			"type": "keybind",
			"default": "F1"
		},
		"reload-keybind": {
			"name": "Reload Textures Keybind",
			"type": "keybind",
			"default": "F2"
		},
		"keybind_anywhere": {
			"name": "Keybind works anywhere",
			"type": "bool",
			"default": false
		}
	},
	"resources": {
		"spritesheets": {
			"RD_modSheet01": [
				"resources/*.png"
			],
			"RD_iconsSheet01": [
				"resources/icons/*.png"
			],
			"RD_profileSheet01": [
				"resources/profile/*.png"
			],
			"RD_commentSheet01": [
				"resources/comments/*.png"
			]
		},
		"sprites": [
			"resources/sprites/*.png"
		],
		"files": [
			"resources/levels.txt",
			"resources/badges/*.png"
		]
	},
	"api": {
		"include": [
			"include/*.hpp",
			"resources/Active.mp3",
			"resources/UltimateDestruction.mp3",
			"resources/tabz.rusdash/lang/*.json",
			"resources/tabz.rusdash/levels/*.txt",
			"resources/tabz.rusdash/resources/*.png",
			"resources/tabz.rusdash/resources/*.fnt",
			"resources/tabz.rusdash/resources/*.plist"
		]
	},
	"tags": [
		"offline",
		"online",
		"gameplay",
		"utility",
		"gdps"
	],
	"links": {
		"homepage": "https://www.rustps.online",
		"community": "https://t.me/RusDash",
		"source": "https://github.com/tbz-root/RusDash"
	},
	"issues": {
		"info": "Have Problems With Mod or Found Bugs?",
		"url": "https://github.com/tbz-root/RusDash/issues"
	}
}